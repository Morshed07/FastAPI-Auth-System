# =================================================================
# Application & Debug Configuration
# =================================================================
PROJECT_NAME="FastAPI Auth System"
VERSION="1.0.0"
DEBUG=True

# =================================================================
# Database Configuration
# =================================================================
# SQLite (Async) for local dev
DATABASE_URL="sqlite+aiosqlite:///./sqlite.db"
# PostgreSQL Example:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/dbname"

# =================================================================
# JWT Authentication Secrets
# Generate random 256-bit hex keys via: python -c "import secrets; print(secrets.token_hex(32))"
# =================================================================
JWT_SECRET_KEY="YOUR_SUPER_SECRET_ACCESS_KEY_GENERATE_WITH_SECRETS_TOKEN_HEX_32"
JWT_REFRESH_SECRET_KEY="YOUR_SUPER_SECRET_REFRESH_KEY_GENERATE_WITH_SECRETS_TOKEN_HEX_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# =================================================================
# Redis Configuration (For OTP storage & Token Blacklisting)
# =================================================================
REDIS_URL="redis://localhost:6379/0"

# =================================================================
# OTP Configuration
# =================================================================
OTP_EXPIRE_SECONDS=300  # 5 Minutes TTL
OTP_COOLDOWN_SECONDS=60 # 1 Minute rate-limit cooldown between resend attempts

# =================================================================
# Email / SMTP Configuration
# =================================================================
MAIL_USERNAME="your_email@gmail.com"
MAIL_PASSWORD="your_app_password"
MAIL_FROM="noreply@yourdomain.com"
MAIL_PORT=587
MAIL_SERVER="smtp.gmail.com"
MAIL_FROM_NAME="FastAPI Auth System"
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True

# Set SUPPRESS_SEND=True for local dev testing (prints email content to console without sending actual email)
SUPPRESS_SEND=True
